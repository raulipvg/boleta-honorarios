ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=db;Port=5432;Database=gestion_honorarios;Username=gestion_runtime;Password=replace-runtime-password;GSS Encryption Mode=Disable
Jwt__Issuer=https://gestion-honorarios.local
Jwt__Audience=gestion-honorarios-api
Jwt__ClientId=gestion-honorarios-spa
Jwt__PrivateKeyPath=/run/secrets/jwt-private-key.pem
Jwt__KeyId=local-rsa-key
# Optional overlap during signing-key rotation:
# Jwt__PreviousKeys__0__KeyId=previous-rsa-key
# Jwt__PreviousKeys__0__PublicKeyPath=/run/secrets/previous-rsa-public-key.pem
DataProtection__KeyRingPath=/home/app/.aspnet/DataProtection-Keys
# In production, provide a dedicated certificate and private key through the secret manager.
DataProtection__CertificatePath=
DataProtection__PrivateKeyPath=
Cors__AllowedOrigin=http://localhost:8080
Cors__AllowedOrigins__0=http://localhost:8080
Cors__AllowedOrigins__1=http://localhost:5173
ForwardedHeaders__KnownProxies__0=172.30.0.4
ForwardedHeaders__KnownProxies__1=172.30.0.5
